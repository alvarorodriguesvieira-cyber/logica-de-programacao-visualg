algoritmo "ConversorDeMoedasComSoma"
// Disciplina : Algoritmos e Lógica de Programação
// Professor  : Gustavo Guanabara (Curso em Vídeo)
// Descrição  : Converte múltiplos valores de Real para Dólar e acumula a soma total das conversões.
// Autor      : Álvaro
// Data       : 20/10/2026

var
   R, D, somaR, somaD: Real
   C, Q: Inteiro

inicio
   C <- 1
   somaR <- 0
   somaD <- 0
   
   Escreva ("Quantas vezes você quer converter? ")
   Leia(Q)
   
   Enquanto (C <= Q) faca
      Escreva("Qual o valor em R$? ")
      Leia(R)
      
      D <- R / 5.03
      
      // Acumuladores de valores
      somaR <- somaR + R
      somaD <- somaD + D
      
      Escreval("O valor convertido é US$: ", D:5:2)
      C <- C + 1
   FimEnquanto

   Escreval("-----------------------------------------")
   Escreval("Soma total de Reais digitados: R$ ", somaR:5:2)
   Escreval("Soma total convertida em Dólares: US$ ", somaD:5:2)

fimalgoritmo

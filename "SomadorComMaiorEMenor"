algoritmo "SomadorComMaiorEMenor"
// Disciplina : Algoritmos e Lógica de Programação
// Professor  : Gustavo Guanabara (Curso em Vídeo)
// Descrição  : Lê 5 valores inteiros, calcula a soma e identifica o maior e menor número digitado.
// Autor      : Álvaro
// Data       : 20/10/2026

var
   cont, N, S, maior, menor : inteiro

inicio
   cont <- 1
   S <- 0
   
   enquanto (cont <= 5) faca
      escreva("Digite o ", cont, "º valor: ")
      leia(N)
      
      // Na primeira repetição, inicializa maior e menor com o primeiro número lido
      se (cont = 1) entao
         maior <- N
         menor <- N
      senao
         se (N > maior) entao
            maior <- N
         fimse
         se (N < menor) entao
            menor <- N
         fimse
      fimse
      
      S <- S + N
      cont <- cont + 1
   fimenquanto
   
   escreval("----------------------------------")
   escreval("A soma de todos os valores foi: ", S)
   escreval("O maior valor digitado foi: ", maior)
   escreval("O menor valor digitado foi: ", menor)
fimalgoritmo

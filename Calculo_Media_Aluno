algoritmo "Calculo_Media_Aluno"
// Disciplina : Lógica de Programação e Algoritmos
// Descrição  : Recebe duas notas, calcula a média e informa a situação do aluno (Aprovado, Recuperação ou Reprovado)
// Autor      : Álvaro
// Data       : 20/10/2026

var
   nota1, nota2, media: real

inicio
   Escreval("========================================")
   Escreval("     CÁLCULO DE MÉDIA DO ALUNO          ")
   Escreval("========================================")
   Escreval("")

   Escreva("Digite a nota da primeira prova: ")
   Leia(nota1)

   Escreva("Digite a nota da segunda prova: ")
   Leia(nota2)

   // Cálculo da média
   media <- (nota1 + nota2) / 2

   Escreval("")
   Escreval("----------------------------------------")
   Escreval("           RESULTADO FINAL              ")
   Escreval("----------------------------------------")
   Escreval("Primeira Nota : ", nota1:5:1)
   Escreval("Segunda Nota  : ", nota2:5:1)
   Escreval("Média Final   : ", media:5:1)
   Escreval("----------------------------------------")

   // Situação do aluno
   Se (media >= 7) entao
      Escreval("Situação: APROVADO! Parabéns!")
   Senao Se (media >= 5) entao
      Escreval("Situação: RECUPERAÇÃO")
   Senao
      Escreval("Situação: REPROVADO")
   FimSe

   Escreval("========================================")

fimalgoritmo

algoritmo "Calculo_Media_Aluno"
// Disciplina : Logica de Programacao e Algoritmos
// Professor  : Projeto Pratico de Aprendizado
// Descricao  : Recebe duas notas de um aluno, calcula a media e exibe a situacao (Aprovado/Reprovado) com relatorio formatado.
// Autor      : Álvaro
// Data       : 17/10/2026

var
   media, nota1, nota2: real

inicio
   // Entrada de Dados
   Escreva("Digite sua nota da primeira prova: ")
   Leia(nota1)
   
   Escreva("Digite sua nota da segunda prova: ")
   Leia(nota2)
   
   // Processamento: Calculo da media aritmetica
   media <- (nota1 + nota2) / 2
   
   Escreval("") // Quebra de linha para organizacao visual
   
   // Tomada de Decisao (Condicional)
   se media <= 4.5 entao
      Escreval("Status: Voce foi REPROVADO")
   senao
      Escreval("Status: Voce foi APROVADO!")
   fimse

   // Relatorio Final de Desempenho (Exibido para ambos os casos)
   Escreval("---------------------------------------")
   Escreval("RESUMO DO DESEMPENHO ACADEMICO")
   Escreval("---------------------------------------")
   Escreval("Primeira Nota : ", nota1:2:1)
   Escreval("Segunda Nota  : ", nota2:2:1)
   Escreval("Media Final   : ", media:2:1)
   Escreval("---------------------------------------")

fimalgoritmo
